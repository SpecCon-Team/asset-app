# Environment
NODE_ENV="development"

# Database Configuration
# -------------------------------------------------
# Local Docker Database (Development)
LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/asset_tracking"

# Supabase Database (Production) - Use pooling for serverless/edge
# Get connection string from: Supabase Dashboard → Settings → Database → Connection string
# Use the Pooler connection string (port 6543) for serverless environments like Render
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR-PROJECT-ID].supabase.co:5432/postgres

# Database Sync Mode (write to both databases)
ENABLE_DUAL_WRITE="false"

# Use Supabase URL (with pooler port 6543 for serverless)
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@[YOUR-PROJECT-ID].supabase.co:6543/postgres?sslmode=require"

# -------------------------------------------------
# Application Configuration
JWT_SECRET="your-jwt-secret-here-generate-a-secure-one"
PORT=4000
CLIENT_URL="http://localhost:5173"

SESSION_SECRET="your-session-secret-here"
CSRF_SECRET="your-csrf-secret-here"
ENCRYPTION_KEY="your-encryption-key-here"

# -------------------------------------------------
# Email Configuration (for password reset emails)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# -------------------------------------------------
# WhatsApp Business API Configuration
# Get credentials from: https://developers.facebook.com
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-business-account-id"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"
WHATSAPP_APP_SECRET="your-app-secret"

# Backup encryption key (for encrypted backups)
BACKUP_ENCRYPTION_KEY="your-backup-encryption-key"

# Enable automated backups (set to "true" in production)
ENABLE_AUTOMATED_BACKUPS="false"
